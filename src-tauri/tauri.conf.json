{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GabeTeX",
  "version": "1.1.2",
  "identifier": "io.github.gabe-rbo.gabetex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "welcome",
        "title": "Welcome to GabeTeX",
        "width": 700,
        "height": 450,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:23119 http://localhost:23119 https://cdn.jsdelivr.net https://raw.githubusercontent.com; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "nsis",
      "msi",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A fast, native-feeling LaTeX editor",
    "linux": {
      "deb": {
        "recommends": ["texlive-base", "texlive-latex-recommended", "texlive-fonts-recommended", "latexmk"]
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "template": "nsis/installer.nsi",
        "languages": [
          "English",
          "Portuguese"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "nsis/hooks.nsh"
      },
      "wix": {
        "language": [
          "en-US",
          "pt-BR"
        ]
      }
    }
  }
}
